{erl_opts, [debug_info]}.
{deps, []}.

{pre_hooks, [
  {compile, "cargo build --release --manifest-path native/fenrir_nif/Cargo.toml"}
]}.

%% Copy the built NIF into priv/ under the name erlang:load_nif/2 expects.
%% Platform-specific: Rust cdylib produces fenrir_nif.dll (Windows),
%% libfenrir_nif.so (Linux), libfenrir_nif.dylib (macOS); Erlang loads NIFs
%% with a .so extension on both Linux and macOS, .dll on Windows.
{post_hooks, [
  {"win32", compile,
   "powershell -NoProfile -Command \"New-Item -ItemType Directory -Force apps/fenrir/priv | Out-Null; Copy-Item native/fenrir_nif/target/release/fenrir_nif.dll apps/fenrir/priv/fenrir_core_nif.dll -Force\""},
  {"darwin", compile,
   "mkdir -p apps/fenrir/priv && cp native/fenrir_nif/target/release/libfenrir_nif.dylib apps/fenrir/priv/fenrir_core_nif.so"},
  {"(linux|freebsd|solaris|gnu)", compile,
   "mkdir -p apps/fenrir/priv && cp native/fenrir_nif/target/release/libfenrir_nif.so apps/fenrir/priv/fenrir_core_nif.so"}
]}.

{profiles, [
  {test, [
    {deps, [
      {proper, "1.4.0"}
    ]}
  ]}
]}.
