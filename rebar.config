{erl_opts, [debug_info]}.
{deps, []}.

%% Build the NIF and copy it into priv/ BEFORE compile, so the artifact is in
%% apps/fenrir/priv/ before rebar3 copies priv/ into _build/<profile>/lib/.../priv/.
%% (A post-compile copy lands too late on a clean build — the runtime then can't
%% find the NIF under _build, which broke CI.) The copy is a cross-platform
%% escript (os:type() picks the right name/extension) — no fragile arch-regex
%% hooks, no PowerShell, and it fails loudly if the artifact is missing.
{pre_hooks, [
  {compile, "cargo build --release --manifest-path native/fenrir_nif/Cargo.toml"},
  {compile, "escript build/copy_nif.escript"}
]}.

{profiles, [
  {test, [
    {deps, [
      {proper, "1.4.0"}
    ]}
  ]}
]}.
